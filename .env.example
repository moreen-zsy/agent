# Core Database (users, conversations, messages)
DATABASE_URL_CORE=postgresql://a2ui:a2ui_password@localhost:5432/a2ui_core

# Food Database (dishes, orders)
DATABASE_URL_FOOD=postgresql://a2ui:a2ui_password@localhost:5432/a2ui_food

# Campus Database (facilities, reservations, payments)
DATABASE_URL_CAMPUS=postgresql://a2ui:a2ui_password@localhost:5432/a2ui_campus

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Server
PORT=3000
NODE_ENV=development

# MCP Servers (optional)
FOOD_MCP_URL=
CAMPUS_MCP_URL=
