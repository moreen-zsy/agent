{
  "name": "@a2ui/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "a2ui-agent",
    "a2ui-core",
    "a2ui-render/*",
    "a2ui-server",
    "apps/gusto/*",
    "apps/campus-web",
    "a2ui-agent/mcp/*",
    "apps/playground"
  ],
  "scripts": {
    "dev:core": "bun --filter @a2ui/core dev",
    "dev:react": "bun --filter @a2ui/react-render dev",
    "dev:playground": "bun --filter @a2ui/app-playground dev",
    "dev:server": "bun --filter @a2ui/server dev",
    "dev": "bun dev:server & bun dev:playground",
    "build": "bun --filter './a2ui-agent' --filter './a2ui-core' --filter './a2ui-render/*' build",
    "test": "bun --filter './a2ui-agent' --filter './a2ui-core' --filter './a2ui-render/*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "catalog:"
  },
