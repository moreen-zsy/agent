{
  "name": "a2ui-server2",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "bunx --bun prisma db verify",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "bun run --watch src/index.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@a2ui/agent": "workspace:*",
    "@ag-ui/client": "catalog:agui",
    "@ag-ui/core": "catalog:agui",
    "@ag-ui/encoder": "catalog:agui",
    "@elysia/bearer": "catalog:server",
    "@elysia/cors": "catalog:server",
    "@elysia/eden": "^1.4.10",
    "@elysia/html": "catalog:server",
    "@elysia/jwt": "catalog:server",
    "@elysia/node": "catalog:server",
    "@elysia/openapi": "catalog:server",
    "@elysia/static": "catalog:server",
    "@prisma/composer": "catalog:prisma",
    "@prisma/composer-prisma-cloud": "catalog:prisma",
    "@prisma/orm-postgres": "catalog:prisma",
    "@sinclair/typebox": "catalog:server",
    "alchemy": "catalog:misc",
    "elysia": "catalog:server",
    "openapi-types": "catalog:server",
    "temporal-polyfill": "catalog:misc",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@prisma/dev": "catalog:prisma",
    "@types/bun": "catalog:",
    "prisma": "catalog:prisma",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:"
  },
  "overrides": {
    "effect": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/vitest": "4.0.3"
  }
}
