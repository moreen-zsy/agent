// use prisma-8
// src/prisma/contract.prisma
model User {
  id            Uuid                  @id @onCreate(uuid())
  email         VarChar(255)          @unique
  password      VarChar(255) 
  name          VarChar(255)?          
  avatar        String?
  phone         VarChar(20)?
  createdAt     Timestamptz          @default(now())  @map("created_at")
  updatedAt     temporal.UpdatedAt          @default(now())  @map("updated_at") 

  // 反向关系
  orders         Orders[]
  UserAddresses  UserAddresses[]  //变更： 一个用户有多个地址， 表与表之间的? 没有任何效果。 
  @@map("users")
}
model UserAddresses {
  id          Uuid         @id @onCreate(uuid())
  userId      Uuid         @map("user_id")    // 外键 + 唯一 = 一对一, 变为一对多不再唯一
  label       VarChar(50)?
  address     String
  phone       VarChar(20)?
  contactName VarChar(100)? @map("contact_name")
  isDefault   Boolean?     @default(false) @map("is_default")
  createdAt   Timestamptz  @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_addresses")
}


model Dishes { 
    id                    Uuid          @id @onCreate(uuid()) // @id 主键  @default(autoincrement())自增主键 
    name                  VarChar(255)                        // @@id ([firstName, lastName]) 复合主键
    description           String?
    full_description      String?       @map("full_description")
    price                 Numeric(10, 2)
    image                 String?
    category              VarChar(50)   
    tags                  String[]?         //Jsonb 是任意数据结构，都能适配这里使用String[]
    ingredients           String[]?         //@default 默认值
    available             Boolean?      @default(true)
    createdAt             Timestamptz() @default(now()) @map("created_at")  
    @@map("dishes")
}
model Orders {
  id            Uuid          @id @onCreate(uuid())
  userId        Uuid          @map("user_id") //@map 映射
  orderNo       VarChar(32)   @unique @map("order_no") //@unique 唯一约束
  items         Jsonb          //这里是[{}]  
  total         Decimal
  status        VarChar(50)   @default("pending")  // 
  address       String?
  phone         VarChar(20)?
  contactName   VarChar(100)? @map("contact_name")
  note          String?
  deliveryType  VarChar(20)   @default("delivery") @map("delivery_type")
  estimatedTime Timestamptz?  @map("estimated_time")
  paymentStatus VarChar(20)   @default("unpaid") @map("payment_status")
  paymentMethod VarChar(20)?  @map("payment_method")
  createdAt     Timestamptz   @default(now()) @map("created_at")
  updatedAt     temporal.UpdatedAt   @default(now()) @map("updated_at")
  // 一对多：一笔订单属于一个用户（onDelete 用 Restrict，避免误删用户时连删订单；
  // 想级联删除就改成 onDelete: Cascade）
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("orders")
    
}

model OrderStatusHistory {
  id         Uuid         @id @onCreate(uuid())
  orderId    Uuid         @map("order_id")
  status     VarChar(50)
  prevStatus VarChar(50)?  @map("prev_status")
  message    String?
  createdAt  Timestamptz  @default(now()) @map("created_at")
  orders     Orders       @relation(fields:[orderId], references: [id], onDelete: Cascade)
  @@map("order_status_history")

}


